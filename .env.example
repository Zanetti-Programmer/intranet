# Copie para .env e preencha
# cp .env.example .env

# ── Portas ────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── PocketBase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PB_URL=http://localhost/pb
PB_ADMIN_EMAIL=admin@empresa.com
PB_ADMIN_PASSWORD=

# ── TLS (HTTPS) ───────────────────────────────────────────────────────────────
# Coloque fullchain.pem e privkey.pem neste diretório
# Para Let's Encrypt: use certbot e aponte para o caminho gerado
TLS_CERT_PATH=./nginx/certs

# ── SMTP (para notificações por e-mail via PocketBase) ────────────────────────
# Configure também em: PocketBase Admin > Settings > Mail settings
PB_SMTP_HOST=smtp.empresa.com
PB_SMTP_PORT=587
PB_SMTP_USERNAME=noreply@empresa.com
PB_SMTP_PASSWORD=
PB_SMTP_FROM=Intranet <noreply@empresa.com>
